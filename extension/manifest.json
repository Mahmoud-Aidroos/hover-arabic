{
  "manifest_version": 3,
  "name": "Hover Arabic \u2014 Online Translator",
  "version": "2.3.0",
  "description": "Translate hovered English words into Arabic on websites and PDFs. Includes an arXiv reader, RTL popups and online caching.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "settings.html",
    "default_title": "Hover Arabic settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "minimum_chrome_version": "140",
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://arxiv.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.mymemory.translated.net https://api.cognitive.microsofttranslator.com https://arxiv.org;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
